{
  "version": "1.0",
  "name": "source-demo",
  "workspace": "/workspace",
  "source": {
    "repository": "https://github.com/kexer2018/todo-app-demo.git",
    "ref": "main",
    "shallow": true,
    "depth": 10
  },
  "steps": [
    {
      "name": "inspect-workspace",
      "image": "alpine:latest",
      "commands": [
        "echo '=== Source checkout contents ==='",
        "ls -la /workspace",
        "echo '---'",
        "find /workspace -maxdepth 2 -type f | head -20"
      ]
    },
    {
      "name": "verify-git",
      "image": "alpine:latest",
      "commands": [
        "apk add --no-cache git >/dev/null 2>&1",
        "cd /workspace && git log --oneline -3",
        "echo '---'",
        "cd /workspace && git rev-parse HEAD"
      ],
      "depends_on": ["inspect-workspace"]
    }
  ]
}
