{
  "version": "1.0",
  "name": "source-demo",
  "workspace": "/workspace",
  "source": {
    "repository": "https://github.com/kexer2018/express-api.git",
    "ref": "main",
    "shallow": true,
    "depth": 10
  },
  "steps": [
    {
      "name": "inspect-workspace",
      "image": "alpine:latest",
      "commands": [
        "echo '=== Source checkout contents ==='",
        "ls -la /workspace",
        "echo '---'",
        "find /workspace -maxdepth 2 -type f | head -20"
      ]
    },
    {
      "name": "verify-git",
      "image": "alpine:latest",
      "commands": [
        "echo '=== Verify git repo ==='",
        "ls -la /workspace/.git",
        "echo '---'",
        "cat /workspace/.git/HEAD",
        "echo '---'",
        "ls /workspace/.git/objects | head -5",
        "echo '---'",
        "echo 'Git checkout verified successfully'"
      ],
      "depends_on": ["inspect-workspace"]
    }
  ]
}
