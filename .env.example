# miniflow 环境变量配置
# 复制为 .env 并填写真实值（.env 文件已被 .gitignore 排除）
#
# 使用方式：
#   cp .env.example .env
#   # 编辑 .env 填入真实 API Key
#   docker compose up -d
#

# ─── LLM 配置（必需）─────────────────────────────────
# OpenAI API Key（也兼容 DeepSeek / Qwen 等）
LLM_API_KEY=sk-your-key-here

# LLM API 基础地址（可选，默认 https://api.openai.com/v1）
# LLM_BASE_URL=https://api.openai.com/v1

# LLM 模型名（可选，默认 gpt-4o-mini）
# LLM_MODEL=gpt-4o-mini
